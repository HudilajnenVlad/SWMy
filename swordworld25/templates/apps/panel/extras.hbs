{{!-- Custom trackers, Bard rhythm and Alchemist cards. --}}
{{#if resources.length}}
<div class="swp-tracker-block">
  {{#each resources}}
  <div class="swp-tracker-res" data-row="{{key}}" style="--pct: {{pct}}%; --res-color: {{color}}">
    <span class="label">{{label}}</span>
    <b class="value">{{value}}{{#if max}}<small>/{{max}}</small>{{/if}}</b>
    {{#if @root.owner}}{{> "systems/swordworld25/templates/apps/panel/steps.hbs" down="SW25.Tracker.Decrease" up="SW25.Tracker.Increase"}}{{/if}}
    <span class="bar"><span></span></span>
  </div>
  {{/each}}
</div>
{{/if}}

{{#if rhythm}}
<div class="swp-tracker-block swp-tracker-rhythm">
  <span class="swp-tracker-title">{{localize "SW25.Rhythm.label"}}</span>
  {{#each rhythm}}
  <span class="swp-tracker-counter" data-tooltip="{{localize label}}">
    {{#if @root.owner}}<a class="swp-mini" data-action="rhythm" data-key="{{key}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}
    <b>{{icon}}{{value}}</b>
    {{#if @root.owner}}<a class="swp-mini" data-action="rhythm" data-key="{{key}}" data-delta="1"><i class="fa-solid fa-plus"></i></a>{{/if}}
  </span>
  {{/each}}
</div>
{{/if}}

{{#if cards}}
<table class="swp-table swp-card-table swp-tracker-cards">
  <thead><tr><th class="name">{{localize "SW25.Card.MaterialCards"}}</th>{{#each cardRanks}}<th>{{this}}</th>{{/each}}</tr></thead>
  <tbody>
    {{#each cards}}
    <tr class="card-{{color}}"><th class="name"><span class="swp-card-swatch"></span>{{localize label}}</th>{{#each ranks}}<td>{{value}}</td>{{/each}}</tr>
    {{/each}}
  </tbody>
</table>
{{/if}}
