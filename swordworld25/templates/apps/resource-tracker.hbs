<div class="swp-tracker">
  {{#if actor}}
  {{> "systems/swordworld25/templates/apps/panel/head.hbs"}}
  {{> "systems/swordworld25/templates/apps/panel/vitals.hbs"}}

  {{#if stats.length}}
  <div class="swp-tracker-stats">
    {{#each stats}}<span class="swp-tracker-stat" data-tooltip="{{tooltip}}"><small>{{label}}</small><b>{{value}}</b></span>{{/each}}
  </div>
  {{/if}}

  {{#if attacks}}
  <div class="swp-tracker-block swp-tracker-attacks">
    <span class="swp-tracker-title">{{localize "SW25.Tracker.Attacks"}}</span>
    {{> "systems/swordworld25/templates/apps/panel/attack-rows.hbs"}}
  </div>
  {{/if}}

  {{> "systems/swordworld25/templates/apps/panel/extras.hbs"}}
  {{> "systems/swordworld25/templates/apps/panel/statuses.hbs"}}
  {{/if}}
</div>
