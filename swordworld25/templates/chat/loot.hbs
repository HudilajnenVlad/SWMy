<div class="sw25 swp swp-chat swp-chat-loot">
  <header class="swp-chat-head">
    <img class="swp-chat-img" src="{{img}}" alt="">
    <div class="swp-chat-titles">
      <span class="swp-chat-title">{{localize "SW25.Loot.Title" name=name}}</span>
      {{#if looter}}<span class="swp-chat-subtitle">{{looter}}</span>{{/if}}
    </div>
  </header>
  <div class="swp-chat-roll">
    <span class="swp-legend">{{localize "SW25.Loot.Roll"}}</span>
    <div class="swp-chat-roll-line">
      <span class="swp-chat-dice">{{#each diceList}}<span class="swp-chat-die d{{this}}">{{swpDieIcon this}}</span>{{/each}}</span>
      {{#if bonus}}<span class="swp-chat-base">{{sw25Signed bonus}}</span>{{/if}}
      <span class="swp-chat-total">{{total}}</span>
    </div>
  </div>
  <table class="swp-loot-table swp-chat-loot-table">
    <tbody>
      {{#each rows}}
      <tr class="{{#if taken}}taken{{/if}}">
        <th>{{#if always}}{{localize "SW25.Loot.Always"}}{{else}}{{roll}}{{/if}}</th>
        <td class="item"><b>{{item}}</b>{{#if quantityLabel}} {{quantityLabel}}{{/if}}{{#if cards}} <small data-tooltip="SW25.Loot.Cards">({{cards}})</small>{{/if}}
          {{#if taken}}<small class="swp-loot-taken"><i class="fa-solid fa-check"></i> {{taken}}</small>{{/if}}</td>
        <td class="price">{{priceLabel}}</td>
        <td class="take">{{#unless taken}}
          <a data-action="lootTake" data-index="{{index}}" data-tooltip="SW25.Loot.TakeHint"><i class="fa-solid fa-hand-holding"></i></a>
          {{#if ../hasParty}}<a data-action="lootParty" data-index="{{index}}" data-tooltip="SW25.Loot.PartyHint"><i class="fa-solid fa-people-group"></i></a>{{/if}}
        {{/unless}}</td>
      </tr>
      {{else}}
      <tr><td colspan="4" class="none">{{localize "SW25.Loot.Nothing"}}</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>
