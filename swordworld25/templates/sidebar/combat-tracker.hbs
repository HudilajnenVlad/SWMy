{{!-- Popcorn tracker: the combatants by side, the side that won initiative first. Within the acting side any
     character takes the turn (play button); the check box marks who has acted this round. --}}
<ol class="combat-tracker plain sw25-popcorn">
  {{#each sides}}
  <li class="sw25-side {{faction}} {{#if acting}}acting{{/if}}">
    <span class="sw25-side-order">{{order}}</span>
    <span class="sw25-side-label">{{label}}</span>
    {{#if acting}}<span class="sw25-side-state">{{localize "SW25.Combat.Acting"}}</span>{{/if}}
    {{#if progress}}<span class="sw25-side-progress" data-tooltip="SW25.Combat.ProgressHint">{{progress}}</span>{{/if}}
  </li>
  {{#each turns}}
  <li class="combatant {{ css }}" data-combatant-id="{{ id }}" data-action="activateCombatant">
    {{#if canToggle}}
    <button type="button" class="inline-control sw25-acted {{#if acted}}on{{/if}}" data-action="toggleActed"
            data-tooltip="{{#if acted}}SW25.Combat.ActedUndo{{else}}SW25.Combat.ActedMark{{/if}}" aria-pressed="{{#if acted}}true{{else}}false{{/if}}">
      <i class="fa-solid {{#if acted}}fa-square-check{{else}}fa-square{{/if}}"></i>
    </button>
    {{else}}
    <span class="sw25-acted {{#if acted}}on{{/if}}"><i class="fa-solid {{#if acted}}fa-square-check{{else}}fa-square{{/if}}"></i></span>
    {{/if}}

    <img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy">

    <div class="token-name">
      <strong class="name">{{ name }}</strong>
      <div class="combatant-controls">
        {{#if @root.user.isGM}}
        <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
                data-action="toggleHidden" data-tooltip aria-label="{{ localize "COMBAT.ToggleVis" }}"></button>
        <button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
                data-action="toggleDefeated" data-tooltip aria-label="{{ localize "COMBAT.ToggleDead" }}"></button>
        {{/if}}
        {{#if canPing}}
        <button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
                data-action="pingCombatant" data-tooltip aria-label="{{ localize "COMBAT.PingCombatant" }}"></button>
        {{/if}}
        {{#unless @root.user.isGM}}
        <button type="button" class="inline-control combatant-control icon fa-solid fa-arrows-to-eye"
                data-action="panToCombatant" data-tooltip aria-label="{{ localize "COMBAT.PanToCombatant" }}"></button>
        {{/unless}}
        <div class="token-effects" data-tooltip-html="{{ effects.tooltip }}">
          {{#each effects.icons}}<img class="token-effect" src="{{ img }}" alt="{{ name }}">{{/each}}
        </div>
      </div>
    </div>

    {{#if resource includeZero=true}}
    <div class="token-resource"><span class="resource">{{ resource }}</span></div>
    {{/if}}

    {{#if canTake}}
    <button type="button" class="sw25-take-turn" data-action="takeTurn" data-tooltip="SW25.Combat.TakeTurn" aria-label="{{localize "SW25.Combat.TakeTurn"}}">
      <i class="fa-solid fa-play"></i>
    </button>
    {{else if active}}
    <span class="sw25-turn-now" data-tooltip="SW25.Combat.TheirTurn"><i class="fa-solid fa-person-running"></i></span>
    {{/if}}

    <div class="token-initiative">
      {{#if initiative includeZero=true}}
      <input type="text" class="initiative-input" inputmode="numeric" pattern="^[+=\-]?\d*" value="{{initiative}}"
             aria-label="{{localize "COMBAT.InitiativeScore"}}" {{#unless @root.user.isGM}}readonly{{/unless}}>
      {{else if isOwner}}
      <button type="button" class="combatant-control roll" data-action="rollInitiative" data-tooltip
              aria-label="{{ localize "COMBAT.InitiativeRoll" }}"
              style="--initiative-icon: url('{{ @root.initiativeIcon.icon }}'); --initiative-icon-hover: url('{{ @root.initiativeIcon.hover }}');"></button>
      {{/if}}
    </div>
  </li>
  {{/each}}
  {{/each}}
</ol>
